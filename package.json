{
  "name": "nx-motion",
  "version": "0.1.3",
  "description": "Turn ordinary video into smooth, higher-frame-rate video.",
  "main": "src/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.cjs",
    "dist:win": "electron-builder --win portable zip --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "dev.nx.motion",
    "productName": "NX Motion",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "NX-Motion-${version}-windows.${ext}",
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico"
    }
  },
  "author": "nerdrx"
}
